# ===== 构建产物 =====
# CMake 构建目录（build.sh 默认输出到 build/）
build/
build-*/
dist/
out/
cmake-build-*/
qt/

# 若有人直接在源码根目录跑 cmake（不推荐），忽略这些生成文件
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt

# ===== Nix =====
# nix build / nix-build 的结果符号链接
result
result-*

# 注意：flake.lock 不应被忽略——它用于锁定依赖版本，建议提交到仓库

# ===== 编译中间文件 =====
*.o
*.obj
*.a
*.so
*.so.*
*.dll
*.exe
*.pdb
*.ilk

# Qt 自动生成
moc_*.cpp
qrc_*.cpp
ui_*.h
*.pro.user
*.pro.user.*
.qmake.stash

# ===== 编辑器 / IDE =====
.vscode/
.idea/
.cache/
.clangd/
compile_commands.json
*.user
*.autosave

# ===== 系统垃圾文件 =====
.DS_Store
Thumbs.db
desktop.ini
*.log