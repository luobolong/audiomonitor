# ===== Build output =====
# CMake build directories (build.sh defaults to build/).
build/
build-*/
dist/
out/
cmake-build-*/
qt/

# Ignore generated files if CMake is run in the source tree.
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
install_manifest.txt

# ===== Nix =====
# Result symlinks from nix build / nix-build.
result
result-*

# Keep flake.lock tracked so dependency versions remain reproducible.

# ===== Compiler output =====
*.o
*.obj
*.a
*.so
*.so.*
*.dll
*.exe
*.pdb
*.ilk

# Qt-generated files.
moc_*.cpp
qrc_*.cpp
ui_*.h
*.pro.user
*.pro.user.*
.qmake.stash

# ===== Editors / IDEs =====
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.cache/
.clangd/
compile_commands.json
*.user
*.autosave

