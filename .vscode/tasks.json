{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure Windows MSVC",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "windows-msvc"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build Debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "windows-debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: configure Windows MSVC",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "CMake: build Release",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "windows-release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: configure Windows MSVC",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "CMake: test Debug",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "windows-debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: build Debug",
      "problemMatcher": []
    },
    {
      "label": "CMake: test Release",
      "type": "process",
      "command": "ctest",
      "args": ["--preset", "windows-release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "CMake: build Release",
      "problemMatcher": []
    }
  ]
}
